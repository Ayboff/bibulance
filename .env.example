# =============================================================================
# Bibulance — Environment variables
# Copy to .env.local (dev) or set in Vercel Project Settings → Environment Variables
# =============================================================================

# --- App ---
# Production example: https://app.bibulance.fr
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only — NEVER expose to the browser / NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Cron (Vercel Cron sends Authorization: Bearer $CRON_SECRET) ---
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Connectors (encrypt API keys at rest) ---
# Generate: openssl rand -hex 32
CONNECTOR_ENCRYPTION_KEY=

# --- Optional observability ---
SENTRY_DSN=
